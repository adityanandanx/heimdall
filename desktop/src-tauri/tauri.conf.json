{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Heimdall",
  "version": "0.1.0",
  "identifier": "com.heimdall.desktop",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Heimdall",
        "width": 880,
        "height": 660,
        "minWidth": 600,
        "minHeight": 500
      }
    ],
    "security": {
      "devCsp": null,
      "csp": {
        "default-src": "'self' customprotocol: asset:",
        "connect-src": "ipc: http://ipc.localhost http://127.0.0.1:3931",
        "font-src": ["'self'", "asset:", "data:"],
        "img-src": ["'self'", "asset:", "http://asset.localhost", "blob:", "data:", "http://127.0.0.1:3931"],
        "style-src": ["'unsafe-inline'", "'self'"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}