{
  "manifest_version": 3,
  "name": "heimdall messenger",
  "version": "0.2.0",
  "description": "Streams the active page's title and URL to the heimdall daemon via a native messaging host.",
  "permissions": ["nativeMessaging"],
  "host_permissions": ["http://*/*", "https://*/*"],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
