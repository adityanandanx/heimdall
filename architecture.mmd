flowchart TB
    subgraph HYPR["🪟 Hyprland (Wayland)"]
        direction LR
        IPC["socket2 events<br/>activewindow · workspace · openwindow<br/>fullscreen · windowtitle"]
        WINMETA["hyprctl activewindow<br/>class · title · geometry"]
        MPRIS["MPRIS (playerctl)<br/>track change · play/pause · players"]
    end

    subgraph CAP["📡 Capture daemon — Python (event-driven)"]
        direction LR
        TRIG["Event Trigger<br/>debounce 1.5s · keepalive 5min<br/>screencast excluded"]
        SHOT["grim -g active-window region<br/>JPEG q80 · ~280KB"]
        PHASH["phash change gate<br/>skip near-duplicates"]
        A11Y["a11y tree (AT-SPI) — winner<br/>flat text · JSON structure"]
        OCR["OCR fallback<br/>RapidOCR · NPU engine (OpenVINO)"]
        EXT["Chromium / Electron<br/>MV3 native-messaging extension<br/>per-tab media stream"]
        SESS["watch-session state machine<br/>MPRIS polling · CDP resolution"]
        TXT["transcripts<br/>yt-dlp captions · lazy ASR<br/>ffmpeg + faster-whisper"]
    end

    subgraph DB["💾 SQLite + FTS5 — ~/.heimdall/"]
        direction LR
        FRAMES["frames<br/>ts · class · title · monitor/ws<br/>a11y_text · a11y_json · ocr_text"]
        TRACKS["tracks<br/>MPRIS play/pause spans"]
        WSESS["watch_sessions<br/>ranges JSON · cues · transcript_source"]
        MSTREAM["media_stream<br/>tab href · title · current_time"]
        EVENTS["events<br/>raw socket2 log"]
        FTS["frames_fts + watch_sessions_fts<br/>FTS5 external content<br/>a11y/ocr + title + transcript"]
    end

    subgraph API["🔌 FastAPI — 127.0.0.1:3030 (loopback)"]
        direction LR
        SEARCH["/search merged · /search/facets<br/>filters: apps · players · ws/monitor · source"]
        FRAMES_EP["/frames · /frames/{id}/image<br/>/sessions"]
        SETTINGS["settings — live spine<br/>engine toggle · pause · forget"]
        HEAL["/health"]
        PIPES_EP["POST /pipes/run/{name}"]
        SCHED["APScheduler<br/>day recap 23:00 · breakdown 23:05"]
    end

    subgraph PIPES["🧩 Pipes — plain functions"]
        direction LR
        RECAP["day recap<br/>load → prompt → completion → render"]
        BREAK["time breakdown — hybrid rules+LLM<br/>merged over N days"]
    end

    subgraph LLM["🧠 llama-server :8080 — Gemma 4 E2B QAT Q4_0"]
        direction LR
        GEMMA["Vulkan-only · temp 0<br/>OpenAI-compatible /v1/chat<br/>json_object"]
    end

    subgraph OBS["👁 Langfuse (self-hosted, optional)"]
        direction LR
        TRACE["pipe runs only<br/>completions · parse errors"]
    end

    subgraph CLIENT["🧑💻 CLI + desktop"]
        direction LR
        CLI["heimdall search · recap · breakdown<br/>status · capture · run · serve"]
        TUI["Tauri 2 client (day-browser style)<br/>Day / Search / Sessions / Status / Settings"]
    end

    IPC --> TRIG
    MPRIS --> TRIG
    MPRIS --> SESS
    WINMETA --> SHOT
    TRIG --> SHOT
    SHOT --> PHASH
    PHASH --> A11Y
    PHASH --> OCR
    EXT --> MSTREAM
    A11Y --> FRAMES
    OCR --> FRAMES
    MSTREAM --> SESS
    SESS --> WSESS
    TXT --> WSESS
    TRIG --> EVENTS
    MPRIS --> TRACKS

    FRAMES --> FTS
    WSESS --> FTS

    FTS --> SEARCH
    FTS --> FRAMES_EP
    SEARCH --> API
    FRAMES_EP --> API

    PIPES_EP --> RECAP
    PIPES_EP --> BREAK
    SCHED --> RECAP
    SCHED --> BREAK
    RECAP --> LLM
    BREAK --> LLM
    RECAP -. trace .-> TRACE
    BREAK -. trace .-> TRACE

    CLI --> API
    TUI --> API
    API -. serve .-> SCHED

    classDef hypr fill:#0f172a,stroke:#94a3b8,color:#e2e8f0
    classDef cap fill:#0c4a6e,stroke:#38bdf8,color:#e0f2fe
    classDef db fill:#4c1d95,stroke:#a78bfa,color:#ede9fe
    classDef api fill:#064e3b,stroke:#34d399,color:#d1fae5
    classDef pipes fill:#0f766e,stroke:#2dd4bf,color:#ccfbf1
    classDef llm fill:#78350f,stroke:#fbbf24,color:#fef3c7
    classDef obs fill:#701a75,stroke:#e879f9,color:#fdf4ff
    classDef client fill:#1e3a8a,stroke:#60a5fa,color:#dbeafe
    class HYPR hypr
    class IPC,WINMETA,MPRIS hypr
    class TRIG,SHOT,PHASH,A11Y,OCR,EXT,SESS,TXT cap
    class FRAMES,TRACKS,WSESS,MSTREAM,EVENTS,FTS db
    class SEARCH,FRAMES_EP,SETTINGS,HEAL,PIPES_EP,SCHED api
    class RECAP,BREAK pipes
    class GEMMA llm
    class TRACE obs
    class CLI,TUI client
