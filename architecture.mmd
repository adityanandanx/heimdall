---
title: Heimdall v1 — local screen memory on Hyprland
---
flowchart TB
    subgraph HYPR["🪟 Hyprland (Wayland)"]
        direction LR
        IPC["socket2 events<br/>activewindow · workspace · openwindow<br/>fullscreen · windowtitle"]
        WINMETA["hyprctl activewindow<br/>class · title · geometry"]
        MPRIS["MPRIS (playerctl)<br/>track change · play/pause"]
    end

    subgraph CAP["📡 Capture daemon — Python (event-driven)"]
        direction LR
        TRIG["Event Trigger<br/>debounce 1.5s · keepalive 5min<br/>screencast excluded"]
        SHOT["grim -g active-window region<br/>JPEG q80 · ~280KB"]
        OCR["tesseract OCR (worker queue)<br/>ENG · ~4.3s/frame"]
    end

    subgraph DB["💾 SQLite + FTS5 — ~/.heimdall/"]
        direction LR
        FRAMES["frames table<br/>ts · class · title · path · ocr"]
        TRACKS["tracks table<br/>MPRIS play/pause spans"]
        EVENTS["events table<br/>raw socket2 log"]
        FTS["frames_fts<br/>FTS5 external content<br/>ocr + title + class"]
    end

    subgraph API["🔌 FastAPI — 127.0.0.1:3030"]
        direction LR
        SEARCH["/search?q=&window_class=…"]
        FRAMES_EP["/frames · /frames/{id}/image"]
        HEALTH["/health"]
        PIPES_EP["POST /pipes/run/{name}"]
        SCHED["APScheduler<br/>recap 23:00 · breakdown 23:05"]
    end

    subgraph PIPES["🧩 Pipes — plain functions"]
        direction LR
        RECAP["day recap<br/>load → prompt → completion<br/>→ parse → render → write"]
        BREAK["time breakdown<br/>hybrid rules+LLM · spans"]
    end

    subgraph LLM["🧠 llama-server :8080"]
        direction LR
        GEMMA["Gemma 4 E2B QAT Q4_0<br/>Vulkan-only · temp 0 · --reasoning off"]
        OPENAI["OpenAI-compatible<br/>/v1/chat/completions<br/>response_format json_object"]
    end

    subgraph OBS["👁 Langfuse (self-hosted, optional)"]
        direction LR
        TRACE["@observe pipe runs<br/>completions · parse errors"]
    end

    subgraph CLIENT["🧑‍💻 CLI — thin HTTP client"]
        direction LR
        CLI["heimdall search · recap · breakdown<br/>status · run · serve"]
    end

    IPC --> TRIG
    MPRIS --> TRIG
    WINMETA --> SHOT
    TRIG --> SHOT
    SHOT --> OCR
    SHOT --> FRAMES
    OCR --> FTS
    TRIG --> EVENTS
    MPRIS --> TRACKS

    FTS --> SEARCH
    FRAMES --> FRAMES_EP

    SEARCH --> API
    FRAMES_EP --> API

    PIPES_EP --> RECAP
    PIPES_EP --> BREAK
    SCHED --> RECAP
    SCHED --> BREAK
    RECAP --> LLM
    BREAK --> LLM
    GEMMA --> OPENAI
    OPENAI --> RECAP
    OPENAI --> BREAK

    RECAP -. trace .-> TRACE
    BREAK -. trace .-> TRACE

    CLI --> API
    API -. serve .-> SCHED

    classDef hypr fill:#0f172a,stroke:#94a3b8,color:#e2e8f0
    classDef cap fill:#0c4a6e,stroke:#38bdf8,color:#e0f2fe
    classDef db fill:#4c1d95,stroke:#a78bfa,color:#ede9fe
    classDef api fill:#064e3b,stroke:#34d399,color:#d1fae5
    classDef pipes fill:#0f766e,stroke:#2dd4bf,color:#ccfbf1
    classDef llm fill:#78350f,stroke:#fbbf24,color:#fef3c7
    classDef obs fill:#701a75,stroke:#e879f9,color:#fdf4ff
    classDef client fill:#1e3a8a,stroke:#60a5fa,color:#dbeafe
    class HYPR hypr
    class IPC,WINMETA,MPRIS hypr
    class TRIG,SHOT,OCR cap
    class FRAMES,TRACKS,EVENTS,FTS db
    class SEARCH,FRAMES_EP,HEALTH,PIPES_EP,SCHED api
    class RECAP,BREAK pipes
    class GEMMA,OPENAI llm
    class TRACE obs
    class CLI client
